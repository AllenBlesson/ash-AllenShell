#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>
#include <string.h>

int main(){
   char *line=NULL;
   size_t bufsize=0;
   char *args[64];
   int i;

   while (1){

   printf("ash>");

   getline(&line,&bufsize,stdin);

   args[0]=strtok(line, " \t\n");
   i=1;
   while((args[i] = strtok(NULL" \t\n") != NULL){
    i++;
   }

   if(args[0]==NULL)continue;
   if(strcmp(args[0],"exit")==0)break;

   if(fork()==0){
   execvp(args[0],args);
   printf("ash:command not found\n");
   exit(1);
  }
  wait(NULL);
 }


 return 0;
}
